{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeamDrop",
  "mainBinaryName": "SeamDrop",
  "version": "0.5.0-beta.1",
  "identifier": "com.seamdrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeamDrop",
        "width": 552,
        "height": 780,
        "minWidth": 300,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#e7e9ee"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Send files between your Mac and PC",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2M0RGRTk2ODRFODBGQ0IKUldUTEQraUVsdjQ5NXRZMHZ1M2xPZWJMSnAya0M3TWVtekVzeVAvelhSc2NDUnk0QUV2emtKVUEK",
      "endpoints": [
        "https://github.com/andrew2grand-lang/seamdrop-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
